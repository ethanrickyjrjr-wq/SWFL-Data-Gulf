{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "ES2023",
    "lib": ["ES2023", "dom", "dom.iterable"],
    "types": ["node", "bun", "next"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "jsx": "preserve",
    "plugins": []
  },
  "include": ["**/*.mts"],
  "exclude": ["node_modules"]
}
